{
  "name": "@sample/kb-chat-react",
  "version": "0.1.0",
  "description": "React hook wrapper around @sample/kb-chat-core for rendering Bedrock Knowledge Bases / Agentic Retrieval streaming responses with your own UI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --dts --external react --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@sample/kb-chat-core": "0.1.0"
  },
  "license": "MIT-0"
}
