{
  "name": "@sample/kb-chat-core",
  "version": "0.1.0",
  "description": "Framework-agnostic streaming session logic for Bedrock Knowledge Bases / Agentic Retrieval responses — parsing, citation mapping, and state, with no rendering.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "license": "MIT-0"
}
